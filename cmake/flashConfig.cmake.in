@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Boost 1.91 CONFIG)
if(NOT TARGET boost::boost AND TARGET Boost::headers)
    add_library(boost::boost INTERFACE IMPORTED)
    set_property(TARGET boost::boost PROPERTY
        INTERFACE_LINK_LIBRARIES Boost::headers)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/flashTargets.cmake")
check_required_components(flash)
